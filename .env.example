# Copy this file to .env for local development and fill in real values.
# In production, set these as environment variables in your host's dashboard.

# --- Django ---
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
# Comma-separated. In production add your host domain, e.g. prana-ai.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset locally to use SQLite. In production the host provides this.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- AI / LLM keys ---
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# --- Email (optional) ---
# If EMAIL_HOST is unset, Django prints emails to the console instead of sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
